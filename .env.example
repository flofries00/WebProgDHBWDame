# Vorlage für lokale Einstellungen: nach ".env" kopieren und Werte anpassen
# Die Datei .env wird nicht ins Repository übernommen.

# Port, auf dem der Server läuft (Standard: 3000)
PORT=3000

# HTTPS (optional): Port und Pfade zu Zertifikat und Schlüssel
# HTTPS_PORT=8443
# TLS_CERT=certs/server.crt
# TLS_KEY=certs/server.key